{
  "schema_version": 1,
  "id": "com.example.shell-view-example",
  "name": "Shell View Example",
  "version": "0.1.0",
  "publisher": "Example",
  "license": "Apache-2.0",
  "description": "Navop shell view 扩展示例（ABI v2）：演示 host.params / navop.resource.* / navop.log 的用法。清单里的 demo provider 只是占位，换成你自己的二进制即可。",
  "engines": {
    "onetcli": ">=0.15.2",
    "nsh": "0.3.0"
  },
  "api": {
    "extension": "1.0",
    "shell": "1.0"
  },
  "permissions": [
    "shell:exec",
    "spawn:./bin/demo-provider"
  ],
  "runtime": {
    "ipc": [
      {
        "id": "demo",
        "entry": {
          "command": "./bin/demo-provider"
        }
      }
    ]
  },
  "contributes": {
    "shellApp": {
      "title": "Tool",
      "description": "演示 host.params / navop.resource.* / navop.log 的用法。",
      "entry": "ui/dist/bundle.js",
      "backends": {
        "demo": "demo"
      },
      "modules": [
        "resource",
        "log"
      ]
    }
  }
}
