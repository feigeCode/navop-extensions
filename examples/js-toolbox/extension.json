{
  "schema_version": 1,
  "id": "com.navop.tools.js-toolbox",
  "name": "JS Toolbox",
  "version": "0.1.0",
  "publisher": "Navop",
  "license": "Apache-2.0",
  "description": "纯 JS 工具扩展示例：本机 hosts 编辑器与加解密/hash 工具，演示 shell 视图权限 → 运行时 capability 装配。",
  "engines": {
    "onetcli": ">=0.16.1",
    "nsh": "0.3.0"
  },
  "api": {
    "extension": "1.0",
    "shell": "1.0"
  },
  "permissions": [
    "shell:exec",
    "fs:read:/etc",
    "fs:write:/etc",
    "fs:read:${pluginDir}/assets",
    "net:tcp:api.ipify.org:443"
  ],
  "contributes": {
    "shellApp": {
      "title": "JS Toolbox",
      "description": "纯 JS 工具集：JSON 格式化、加解密/hash、本机 hosts 编辑。",
      "entry": "ui/dist/bundle.js",
      "backends": {},
      "modules": [
        "log"
      ],
      "category": "text",
      "keywords": [
        "json",
        "hash",
        "base64",
        "uuid",
        "hosts",
        "dns"
      ]
    }
  }
}
