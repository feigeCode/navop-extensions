{
  "name": "navop-extensions",
  "version": "0.0.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "navop-extensions",
      "version": "0.0.0",
      "license": "Apache-2.0",
      "workspaces": [
        "packages/extension-kit",
        "packages/create-extension",
        "templates/extension-basic/ui",
        "extensions/composite/*/ui",
        "examples/*/ui"
      ],
      "engines": {
        "node": ">=20"
      }
    },
    "examples/js-toolbox/ui": {
      "name": "@navop-ext/js-toolbox-ui",
      "dependencies": {
        "@navop/extension-kit": "*"
      }
    },
    "examples/shell-view-example/ui": {
      "name": "@navop-ext/shell-view-example-ui",
      "dependencies": {
        "@navop/extension-kit": "*"
      }
    },
    "extensions/composite/dev-tools/ui": {
      "name": "@navop-ext/dev-tools-ui",
      "dependencies": {
        "@navop/extension-kit": "*"
      }
    },
    "extensions/composite/docker/ui": {
      "name": "@navop-ext/docker-ui",
      "dependencies": {
        "@navop/extension-kit": "*"
      }
    },
    "extensions/composite/elasticsearch/ui": {
      "name": "@navop-ext/elasticsearch-ui",
      "dependencies": {
        "@navop/extension-kit": "*"
      }
    },
    "extensions/composite/mqtt/ui": {
      "name": "@navop-ext/mqtt-ui",
      "dependencies": {
        "@navop/extension-kit": "*"
      }
    },
    "extensions/composite/rocketmq/ui": {
      "name": "@navop-ext/rocketmq-ui",
      "dependencies": {
        "@navop/extension-kit": "*"
      }
    },
    "extensions/composite/tmpl-check/ui": {
      "name": "@navop-ext/tmpl-ui",
      "dependencies": {
        "@navop/extension-kit": "*"
      }
    },
    "node_modules/@navop-ext/dev-tools-ui": {
      "resolved": "extensions/composite/dev-tools/ui",
      "link": true
    },
    "node_modules/@navop-ext/docker-ui": {
      "resolved": "extensions/composite/docker/ui",
      "link": true
    },
    "node_modules/@navop-ext/elasticsearch-ui": {
      "resolved": "extensions/composite/elasticsearch/ui",
      "link": true
    },
    "node_modules/@navop-ext/js-toolbox-ui": {
      "resolved": "examples/js-toolbox/ui",
      "link": true
    },
    "node_modules/@navop-ext/mqtt-ui": {
      "resolved": "extensions/composite/mqtt/ui",
      "link": true
    },
    "node_modules/@navop-ext/rocketmq-ui": {
      "resolved": "extensions/composite/rocketmq/ui",
      "link": true
    },
    "node_modules/@navop-ext/shell-view-example-ui": {
      "resolved": "examples/shell-view-example/ui",
      "link": true
    },
    "node_modules/@navop-ext/template-ui": {
      "resolved": "templates/extension-basic/ui",
      "link": true
    },
    "node_modules/@navop-ext/tmpl-ui": {
      "resolved": "extensions/composite/tmpl-check/ui",
      "link": true
    },
    "node_modules/@navop/create-extension": {
      "resolved": "packages/create-extension",
      "link": true
    },
    "node_modules/@navop/extension-kit": {
      "resolved": "packages/extension-kit",
      "link": true
    },
    "packages/create-extension": {
      "name": "@navop/create-extension",
      "version": "0.1.0",
      "license": "Apache-2.0",
      "bin": {
        "create-extension": "cli.mjs",
        "navop-ext": "cli.mjs"
      },
      "engines": {
        "node": ">=20"
      }
    },
    "packages/extension-kit": {
      "name": "@navop/extension-kit",
      "version": "0.1.0",
      "license": "Apache-2.0"
    },
    "templates/extension-basic/ui": {
      "name": "@navop-ext/template-ui",
      "dependencies": {
        "@navop/extension-kit": "^0.1.0"
      }
    }
  }
}
