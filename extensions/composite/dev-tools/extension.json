{
  "schema_version": 1,
  "id": "com.navop.devtools",
  "name": "开发者工具",
  "version": "0.1.0",
  "publisher": "Navop",
  "license": "Apache-2.0",
  "description": "Navop 扩展开发工作台：加载本地工程目录、打开/重载扩展视图、查看校验错误。 Load local extension projects, open/reload views, inspect manifest errors.",
  "categories": ["developer-tools"],
  "keywords": ["devtools", "extension", "debug"],
  "engines": {
    "onetcli": ">=0.16.1",
    "gpui_shell": "0.2.0"
  },
  "api": {
    "extension": "1.0",
    "shell": "1.0"
  },
  "permissions": ["shell:exec"],
  "contributes": {
    "shellViews": [
      {
        "id": "workbench",
        "title": "开发者工具",
        "description": "扩展工程调试工作台",
        "entry": "ui/workbench.js",
        "surface": "tab",
        "singleton": true,
        "backends": {},
        "modules": ["dev", "log"]
      }
    ]
  }
}
