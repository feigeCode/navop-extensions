{
  "schema_version": 1,
  "id": "com.navop.elasticsearch",
  "name": "Elasticsearch 9",
  "version": "0.1.0",
  "publisher": "Navop",
  "license": "Apache-2.0",
  "description": "面向 Elasticsearch 9.x 的原生 Rust SDK 管理扩展，支持集群概览、索引浏览/管理、文档搜索、别名维护与异步任务。 Native Rust SDK extension for Elasticsearch 9.x with cluster overview, index management, document search, alias maintenance, and asynchronous jobs.",
  "categories": [
    "database",
    "search",
    "developer-tools"
  ],
  "keywords": [
    "elasticsearch",
    "search",
    "index",
    "observability"
  ],
  "engines": {
    "onetcli": ">=0.15.2",
    "gpui_shell": "0.2.0"
  },
  "api": {
    "extension": "1.0",
    "shell": "1.0"
  },
  "permissions": [
    "shell:exec",
    "spawn:./bin/elasticsearch-provider",
    "net:tcp:*:9200",
    "net:tcp:*:443",
    "secrets:read:self.*"
  ],
  "runtime": {
    "ipc": [
      {
        "id": "main",
        "entry": {
          "command": "./bin/elasticsearch-provider"
        },
        "transport": {
          "kind": "local_socket",
          "connect_timeout_ms": 5000
        },
        "auto_restart": true,
        "max_restart_attempts": 3,
        "shutdown_grace_ms": 2500
      }
    ]
  },
  "contributes": {
    "connections": [
      {
        "id": "elasticsearch9",
        "label": "Elasticsearch 9",
        "description": "Connect to an Elasticsearch 9.x cluster.",
        "runtimeId": "main",
        "resourceType": "elasticsearch",
        "shellViewId": "console",
        "form": {
          "tabs": [
            {
              "id": "general",
              "label": "General",
              "fields": [
                {
                  "id": "url",
                  "label": "URL",
                  "fieldType": "Text",
                  "required": true,
                  "defaultValue": "http://localhost:9200",
                  "placeholder": "https://localhost:9200"
                },
                {
                  "id": "auth_type",
                  "label": "Authentication",
                  "fieldType": "Select",
                  "required": true,
                  "defaultValue": "none",
                  "options": [
                    {
                      "value": "none",
                      "label": "None"
                    },
                    {
                      "value": "api_key",
                      "label": "API key"
                    },
                    {
                      "value": "basic",
                      "label": "Username and password"
                    },
                    {
                      "value": "bearer",
                      "label": "Bearer token"
                    }
                  ]
                },
                {
                  "id": "username",
                  "label": "Username",
                  "fieldType": "Text",
                  "required": true,
                  "visibleWhen": [
                    {
                      "field": "auth_type",
                      "equals": "basic"
                    }
                  ]
                },
                {
                  "id": "api_key",
                  "label": "Encoded API key",
                  "fieldType": "Password",
                  "required": true,
                  "secret": true,
                  "visibleWhen": [
                    {
                      "field": "auth_type",
                      "equals": "api_key"
                    }
                  ]
                },
                {
                  "id": "password",
                  "label": "Password",
                  "fieldType": "Password",
                  "required": true,
                  "secret": true,
                  "visibleWhen": [
                    {
                      "field": "auth_type",
                      "equals": "basic"
                    }
                  ]
                },
                {
                  "id": "token",
                  "label": "Bearer token",
                  "fieldType": "Password",
                  "required": true,
                  "secret": true,
                  "visibleWhen": [
                    {
                      "field": "auth_type",
                      "equals": "bearer"
                    }
                  ]
                }
              ]
            }
          ]
        }
      }
    ],
    "resourceWorkbenches": [
      {
        "schemaVersion": 1,
        "id": "elasticsearch",
        "title": "Elasticsearch",
        "connectionIds": [
          "elasticsearch9"
        ],
        "runtimeId": "main",
        "resourceType": "elasticsearch",
        "defaultPage": "overview",
        "operations": {
          "clusterInfo": {
            "mode": "invoke",
            "method": "elasticsearch/cluster/info",
            "requires": [
              "elasticsearch/cluster/info"
            ],
            "effect": "read"
          },
          "clusterHealth": {
            "mode": "invoke",
            "method": "elasticsearch/cluster/health",
            "requires": [
              "elasticsearch/cluster/health"
            ],
            "effect": "read"
          },
          "listIndices": {
            "mode": "invoke",
            "method": "elasticsearch/index/list",
            "requires": [
              "elasticsearch/index/list"
            ],
            "effect": "read"
          },
          "listNodes": {
            "mode": "invoke",
            "method": "elasticsearch/nodes/list",
            "requires": [
              "elasticsearch/nodes/list"
            ],
            "effect": "read"
          },
          "search": {
            "mode": "job",
            "method": "elasticsearch/search/async",
            "requires": [
              "elasticsearch/search/async"
            ],
            "effect": "read",
            "params": {
              "query": {
                "source": "input",
                "path": "/query",
                "type": "string"
              }
            }
          },
          "clusterStats": {
            "mode": "invoke",
            "method": "elasticsearch/cluster/stats",
            "requires": [
              "elasticsearch/cluster/stats"
            ],
            "effect": "read"
          },
          "indexGet": {
            "mode": "invoke",
            "method": "elasticsearch/index/get",
            "requires": [
              "elasticsearch/index/get"
            ],
            "effect": "read",
            "params": {
              "name": {
                "source": "route",
                "path": "/name",
                "type": "string"
              }
            }
          },
          "indexMapping": {
            "mode": "invoke",
            "method": "elasticsearch/index/mapping",
            "requires": [
              "elasticsearch/index/mapping"
            ],
            "effect": "read",
            "params": {
              "name": {
                "source": "route",
                "path": "/name",
                "type": "string"
              }
            }
          },
          "indexSettings": {
            "mode": "invoke",
            "method": "elasticsearch/index/settings",
            "requires": [
              "elasticsearch/index/settings"
            ],
            "effect": "read",
            "params": {
              "name": {
                "source": "route",
                "path": "/name",
                "type": "string"
              }
            }
          },
          "indexAliases": {
            "mode": "invoke",
            "method": "elasticsearch/index/aliases",
            "requires": [
              "elasticsearch/index/aliases"
            ],
            "effect": "read",
            "params": {
              "name": {
                "source": "route",
                "path": "/name",
                "type": "string"
              }
            }
          },
          "indexStats": {
            "mode": "invoke",
            "method": "elasticsearch/index/stats",
            "requires": [
              "elasticsearch/index/stats"
            ],
            "effect": "read",
            "params": {
              "name": {
                "source": "route",
                "path": "/name",
                "type": "string"
              }
            }
          },
          "indexShards": {
            "mode": "invoke",
            "method": "elasticsearch/index/shards",
            "requires": [
              "elasticsearch/index/shards"
            ],
            "effect": "read"
          },
          "indexCreate": {
            "mode": "invoke",
            "method": "elasticsearch/index/create",
            "requires": [
              "elasticsearch/index/create"
            ],
            "effect": "write",
            "params": {
              "name": {
                "source": "input",
                "path": "/name",
                "type": "string"
              },
              "mappings": {
                "source": "input",
                "path": "/mappings",
                "type": "json"
              },
              "settings": {
                "source": "input",
                "path": "/settings",
                "type": "json"
              }
            }
          },
          "indexDelete": {
            "mode": "invoke",
            "method": "elasticsearch/index/delete",
            "requires": [
              "elasticsearch/index/delete"
            ],
            "effect": "destructive",
            "params": {
              "name": {
                "source": "selection",
                "path": "/name",
                "type": "string"
              }
            }
          },
          "indexRefresh": {
            "mode": "invoke",
            "method": "elasticsearch/index/refresh",
            "requires": [
              "elasticsearch/index/refresh"
            ],
            "effect": "write",
            "params": {
              "name": {
                "source": "selection",
                "path": "/name",
                "type": "string"
              }
            }
          },
          "indexOpen": {
            "mode": "invoke",
            "method": "elasticsearch/index/open",
            "requires": [
              "elasticsearch/index/open"
            ],
            "effect": "write",
            "params": {
              "name": {
                "source": "selection",
                "path": "/name",
                "type": "string"
              }
            }
          },
          "indexClose": {
            "mode": "invoke",
            "method": "elasticsearch/index/close",
            "requires": [
              "elasticsearch/index/close"
            ],
            "effect": "write",
            "params": {
              "name": {
                "source": "selection",
                "path": "/name",
                "type": "string"
              }
            }
          },
          "indexAliasUpdate": {
            "mode": "invoke",
            "method": "elasticsearch/index/alias/update",
            "requires": [
              "elasticsearch/index/alias/update"
            ],
            "effect": "write",
            "params": {
              "actions": {
                "source": "input",
                "path": "/actions",
                "type": "json"
              }
            }
          },
          "count": {
            "mode": "invoke",
            "method": "elasticsearch/count",
            "requires": [
              "elasticsearch/count"
            ],
            "effect": "read",
            "params": {
              "query": {
                "source": "input",
                "path": "/query",
                "type": "string"
              }
            }
          },
          "documentGet": {
            "mode": "invoke",
            "method": "elasticsearch/document/get",
            "requires": [
              "elasticsearch/document/get"
            ],
            "effect": "read",
            "params": {
              "name": {
                "source": "route",
                "path": "/name",
                "type": "string"
              },
              "id": {
                "source": "route",
                "path": "/id",
                "type": "string"
              }
            }
          },
          "documentIndex": {
            "mode": "invoke",
            "method": "elasticsearch/document/index",
            "requires": [
              "elasticsearch/document/index"
            ],
            "effect": "write",
            "params": {
              "name": {
                "source": "input",
                "path": "/name",
                "type": "string"
              },
              "id": {
                "source": "input",
                "path": "/id",
                "type": "string"
              },
              "body": {
                "source": "input",
                "path": "/body",
                "type": "json"
              }
            }
          },
          "documentDelete": {
            "mode": "invoke",
            "method": "elasticsearch/document/delete",
            "requires": [
              "elasticsearch/document/delete"
            ],
            "effect": "destructive",
            "params": {
              "name": {
                "source": "selection",
                "path": "/name",
                "type": "string"
              },
              "id": {
                "source": "selection",
                "path": "/id",
                "type": "string"
              }
            }
          }
        },
        "navigation": [
          {
            "pageId": "overview"
          },
          {
            "pageId": "indices"
          },
          {
            "pageId": "search"
          },
          {
            "pageId": "tasks"
          },
          {
            "pageId": "nodes"
          },
          {
            "pageId": "index-create"
          },
          {
            "pageId": "index-shards"
          }
        ],
        "pages": [
          {
            "id": "overview",
            "title": "Overview",
            "template": "json",
            "renderer": {
              "kind": "native"
            },
            "load": {
              "operation": "clusterInfo"
            }
          },
          {
            "id": "indices",
            "title": "Indices",
            "template": "collection",
            "renderer": {
              "kind": "native"
            },
            "load": {
              "operation": "listIndices"
            },
            "collection": {
              "itemsPath": "/indices",
              "keyPaths": [
                "/name"
              ],
              "pagination": {
                "kind": "none"
              },
              "columns": [
                {
                  "id": "name",
                  "title": "Name",
                  "path": "/name",
                  "type": "string"
                },
                {
                  "id": "health",
                  "title": "Health",
                  "path": "/health",
                  "type": "display",
                  "style": "badge"
                },
                {
                  "id": "status",
                  "title": "Status",
                  "path": "/status",
                  "type": "display",
                  "style": "badge"
                },
                {
                  "id": "pri",
                  "title": "Shards",
                  "path": "/pri",
                  "type": "display"
                },
                {
                  "id": "rep",
                  "title": "Replicas",
                  "path": "/rep",
                  "type": "display"
                },
                {
                  "id": "docs",
                  "title": "Docs",
                  "path": "/docs",
                  "type": "display"
                },
                {
                  "id": "size",
                  "title": "Size",
                  "path": "/size_bytes",
                  "type": "display",
                  "style": "muted"
                },
                {
                  "id": "created",
                  "title": "Created",
                  "path": "/created",
                  "type": "display",
                  "style": "muted"
                }
              ],
              "open": {
                "pageId": "index-detail",
                "route": {
                  "name": {
                    "source": "selection",
                    "path": "/name",
                    "type": "string"
                  }
                }
              },
              "actions": [
                {
                  "id": "open",
                  "label": "Open",
                  "operation": "indexOpen"
                },
                {
                  "id": "close",
                  "label": "Close",
                  "operation": "indexClose"
                },
                {
                  "id": "refresh",
                  "label": "Refresh",
                  "operation": "indexRefresh"
                },
                {
                  "id": "delete",
                  "label": "Delete",
                  "operation": "indexDelete"
                }
              ]
            }
          },
          {
            "id": "search",
            "title": "Search",
            "template": "query",
            "renderer": {
              "kind": "native"
            },
            "inputs": [
              {
                "id": "query",
                "type": "string",
                "editor": "text",
                "default": "*",
                "required": true
              }
            ],
            "execute": {
              "operation": "search"
            }
          },
          {
            "id": "tasks",
            "title": "Tasks",
            "template": "tasks",
            "renderer": {
              "kind": "native"
            },
            "scope": "session"
          },
          {
            "id": "nodes",
            "title": "Nodes",
            "template": "collection",
            "renderer": {
