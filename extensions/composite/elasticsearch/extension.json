            ]
          },
          {
            "id": "indices",
            "title": "Indices",
            "renderer": {
              "kind": "native"
            },
            "load": {
              "operation": "listIndices"
            },
            "stack": [
              {
                "kind": "table",
                "itemsPath": "/indices",
                "keyPaths": [
                  "/name"
                ],
                "pagination": {
                  "kind": "none"
                },
                "columns": [
                  {
                    "id": "name",
                    "title": "Name",
                    "path": "/name",
                    "type": "string"
                  },
                  {
