                "title": "Create index",
                "pageId": "index-create",
                "route": {}
              }
            ]
          },
          {
            "id": "search",
            "title": "Search",
            "renderer": {
              "kind": "native"
            },
            "stack": [
              {
                "kind": "form",
                "submit": {
                  "operation": "search"
                },
                "inputs": [
                  {
                    "id": "query",
                    "type": "string",
                    "editor": "text",
                    "default": "*",
