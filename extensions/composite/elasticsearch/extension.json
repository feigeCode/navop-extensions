{
  "schema_version": 1,
  "id": "com.navop.elasticsearch",
  "name": "Elasticsearch 9",
  "version": "0.1.0",
  "publisher": "Navop",
  "license": "Apache-2.0",
  "description": "面向 Elasticsearch 9.x 的原生 Rust SDK 管理扩展，支持集群信息、索引浏览和异步搜索。 Native Rust SDK extension for Elasticsearch 9.x with cluster information, index browsing, and asynchronous search.",
  "categories": ["database", "search", "developer-tools"],
  "keywords": ["elasticsearch", "search", "index", "observability"],
  "engines": {
    "onetcli": ">=0.15.2",
    "gpui_shell": "0.2.0"
  },
  "api": {
    "extension": "1.0",
    "shell": "1.0"
  },
  "permissions": [
    "shell:exec",
    "spawn:./bin/elasticsearch-provider",
    "net:tcp:*:9200",
    "net:tcp:*:443",
    "secrets:read:self.*"
  ],
  "runtime": {
    "ipc": [
      {
        "id": "main",
        "entry": {
          "command": "./bin/elasticsearch-provider"
        },
        "transport": {
          "kind": "local_socket",
          "connect_timeout_ms": 5000
        },
        "auto_restart": true,
        "max_restart_attempts": 3,
        "shutdown_grace_ms": 2500
      }
    ]
  },
  "contributes": {
    "connections": [
      {
        "id": "elasticsearch9",
        "label": "Elasticsearch 9",
        "description": "Connect to an Elasticsearch 9.x cluster.",
        "runtimeId": "main",
        "resourceType": "elasticsearch",
        "shellViewId": "explorer",
        "form": {
          "tabs": [
            {
              "id": "general",
              "label": "General",
              "fields": [
                {
                  "id": "url",
                  "label": "URL",
                  "fieldType": "Text",
                  "required": true,
                  "defaultValue": "http://localhost:9200",
                  "placeholder": "https://localhost:9200"
                },
                {
                  "id": "auth_type",
                  "label": "Authentication",
                  "fieldType": "Select",
                  "required": true,
                  "defaultValue": "none",
                  "options": [
                    { "value": "none", "label": "None" },
                    { "value": "api_key", "label": "API key" },
                    { "value": "basic", "label": "Username and password" },
                    { "value": "bearer", "label": "Bearer token" }
                  ]
                },
                {
                  "id": "username",
                  "label": "Username",
                  "fieldType": "Text",
                  "required": true,
                  "visibleWhen": [
                    { "field": "auth_type", "equals": "basic" }
                  ]
                },
                {
                  "id": "api_key",
                  "label": "Encoded API key",
                  "fieldType": "Password",
                  "required": true,
                  "secret": true,
                  "visibleWhen": [
                    { "field": "auth_type", "equals": "api_key" }
                  ]
                },
                {
                  "id": "password",
                  "label": "Password",
                  "fieldType": "Password",
                  "required": true,
                  "secret": true,
                  "visibleWhen": [
                    { "field": "auth_type", "equals": "basic" }
                  ]
                },
                {
                  "id": "token",
                  "label": "Bearer token",
                  "fieldType": "Password",
                  "required": true,
                  "secret": true,
                  "visibleWhen": [
                    { "field": "auth_type", "equals": "bearer" }
                  ]
                }
              ]
            }
          ]
        }
      }
    ],
    "resourceWorkbenches": [
      {
        "schemaVersion": 1,
        "id": "elasticsearch",
        "title": "Elasticsearch",
        "connectionIds": ["elasticsearch9"],
        "runtimeId": "main",
        "resourceType": "elasticsearch",
        "defaultPage": "overview",
        "operations": {
          "clusterInfo": {
            "mode": "invoke",
            "method": "elasticsearch/cluster/info",
            "requires": ["elasticsearch/cluster/info"],
            "effect": "read"
          },
          "listIndices": {
            "mode": "invoke",
            "method": "elasticsearch/index/list",
            "requires": ["elasticsearch/index/list"],
            "effect": "read"
          },
          "indexInfo": {
            "mode": "invoke",
            "method": "elasticsearch/index/get",
            "requires": ["elasticsearch/index/get"],
            "effect": "read",
            "params": {
              "name": {"source": "route", "path": "/name", "type": "string"}
            }
          },
          "indexMapping": {
            "mode": "invoke",
            "method": "elasticsearch/index/mapping",
            "requires": ["elasticsearch/index/mapping"],
            "effect": "read",
            "params": {
              "name": {"source": "route", "path": "/name", "type": "string"}
            }
          },
          "search": {
            "mode": "job",
            "method": "elasticsearch/search/async",
            "requires": ["elasticsearch/search/async"],
            "effect": "read",
            "params": {
              "query": {"source": "input", "path": "/query", "type": "string"}
            }
          }
        },
        "navigation": [
          {"pageId": "overview"},
          {"pageId": "indices"},
          {"pageId": "search"},
          {"pageId": "tasks"}
        ],
        "tree": [
          {
            "id": "indices",
            "title": "Indices",
            "pageId": "indices",
            "children": {
              "operation": "listIndices",
              "itemsPath": "/indices",
              "keyPaths": ["/name"],
              "labelPath": "/name"
            }
          }
        ],
        "pages": [
          {
            "id": "overview",
            "title": "Overview",
            "template": "json",
            "renderer": {"kind": "native"},
            "load": {"operation": "clusterInfo"}
          },
          {
            "id": "indices",
            "title": "Indices",
            "template": "collection",
            "renderer": {"kind": "native"},
            "load": {"operation": "listIndices"},
            "collection": {
              "itemsPath": "/indices",
              "keyPaths": ["/name"],
              "pagination": {"kind": "none"},
              "columns": [
                {"id": "name", "title": "Name", "path": "/name", "type": "string"},
                {"id": "health", "title": "Health", "path": "/health", "type": "string"},
                {"id": "docs", "title": "Documents", "path": "/docs", "type": "display"},
                {"id": "size", "title": "Size (bytes)", "path": "/size_bytes", "type": "display"}
              ],
              "open": {
                "pageId": "index-detail",
                "route": {
                  "name": {"source": "selection", "path": "/name", "type": "string"}
                }
              }
            }
          },
          {
            "id": "index-detail",
            "title": "Index",
            "template": "json",
            "renderer": {"kind": "native"},
            "route": {"name": {"type": "string", "required": true}},
            "load": {"operation": "indexInfo"},
            "links": [
              {
                "title": "Mapping",
                "pageId": "mapping",
                "route": {
                  "name": {"source": "route", "path": "/name", "type": "string"}
                }
              }
            ]
          },
          {
            "id": "mapping",
            "title": "Mapping",
            "template": "json",
            "renderer": {"kind": "native"},
            "route": {"name": {"type": "string", "required": true}},
            "load": {"operation": "indexMapping"}
          },
          {
            "id": "search",
            "title": "Search",
            "template": "query",
            "renderer": {"kind": "shell", "viewId": "search-editor", "fallback": "native"},
            "inputs": [{"id": "query", "type": "string", "editor": "text", "default": "*", "required": true}],
            "execute": {"operation": "search"}
          },
          {
            "id": "tasks",
            "title": "Tasks",
            "template": "tasks",
            "renderer": {"kind": "native"},
            "scope": "session"
          }
        ]
      }
    ],
    "shellViews": [
      {
        "id": "search-editor",
        "title": "Elasticsearch Search Editor",
        "description": "Embedded professional search editor for the native workbench.",
        "entry": "ui/search-editor.js",
        "surface": "tab",
        "singleton": false,
        "backends": {
          "search": "main"
        },
        "modules": ["context", "workbench"]
      },
      {
        "id": "explorer",
        "title": "Elasticsearch 9",
        "description": "Browse an Elasticsearch 9 cluster and run searches.",
        "entry": "ui/explorer.js",
        "surface": "tab",
        "singleton": false,
        "backends": {
          "search": "main"
        },
        "modules": [
          "context",
          "resource",
          "job",
          "event",
          "blob",
          "runtime",
          "log"
        ]
      }
    ]
  }
}
