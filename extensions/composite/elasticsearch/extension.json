            },
            "collection": {
              "itemsPath": "/nodes",
              "keyPaths": [
                "/name"
              ],
              "pagination": {
                "kind": "none"
              },
              "columns": [
                {
                  "id": "name",
                  "title": "Name",
                  "path": "/name",
                  "type": "string"
                },
                {
                  "id": "ip",
                  "title": "IP",
                  "path": "/ip",
                  "type": "display",
