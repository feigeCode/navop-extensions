                {
                  "id": "disk",
                  "title": "Disk %",
                  "path": "/disk_used_percent",
                  "type": "display"
                },
                {
                  "id": "master",
                  "title": "Master",
                  "path": "/master",
                  "type": "display",
                  "style": "badge"
                },
                {
                  "id": "version",
                  "title": "Version",
                  "path": "/version",
                  "type": "display",
                  "style": "muted"
                }
              ]
            }
