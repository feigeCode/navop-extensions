            "requires": [
              "elasticsearch/index/aliases"
            ],
            "effect": "read",
            "params": {
              "name": {
                "source": "route",
                "path": "/name",
                "type": "string"
              }
            }
          },
          "indexStats": {
            "mode": "invoke",
            "method": "elasticsearch/index/stats",
            "requires": [
              "elasticsearch/index/stats"
            ],
            "effect": "read",
            "params": {
              "name": {
                "source": "route",
                "path": "/name",
                "type": "string"
              }
            }
          },
          "indexShards": {
            "mode": "invoke",
            "method": "elasticsearch/index/shards",
            "requires": [
              "elasticsearch/index/shards"
            ],
            "effect": "read",
            "params": {
              "name": {
                "source": "route",
                "path": "/name",
                "type": "string"
              }
            }
          },
          "indexCreate": {
            "mode": "invoke",
            "method": "elasticsearch/index/create",
            "requires": [
              "elasticsearch/index/create"
            ],
            "effect": "write",
            "params": {
              "name": {
                "source": "input",
                "path": "/name",
                "type": "string"
              },
              "mappings": {
                "source": "input",
                "path": "/mappings",
                "type": "json"
              },
              "settings": {
                "source": "input",
                "path": "/settings",
                "type": "json"
              }
            }
          },
          "indexDelete": {
            "mode": "invoke",
            "method": "elasticsearch/index/delete",
            "requires": [
              "elasticsearch/index/delete"
            ],
            "effect": "destructive",
            "params": {
              "name": {
                "source": "selection",
                "path": "/name",
                "type": "string"
              }
            }
          },
          "indexRefresh": {
            "mode": "invoke",
            "method": "elasticsearch/index/refresh",
            "requires": [
              "elasticsearch/index/refresh"
            ],
            "effect": "write",
            "params": {
              "name": {
                "source": "selection",
                "path": "/name",
                "type": "string"
              }
            }
          },
          "indexOpen": {
            "mode": "invoke",
            "method": "elasticsearch/index/open",
            "requires": [
              "elasticsearch/index/open"
            ],
            "effect": "write",
            "params": {
              "name": {
                "source": "selection",
                "path": "/name",
                "type": "string"
              }
            }
          },
          "indexClose": {
            "mode": "invoke",
            "method": "elasticsearch/index/close",
            "requires": [
              "elasticsearch/index/close"
            ],
            "effect": "write",
            "params": {
              "name": {
                "source": "selection",
                "path": "/name",
                "type": "string"
              }
            }
          },
          "indexAliasUpdate": {
            "mode": "invoke",
            "method": "elasticsearch/index/alias/update",
            "requires": [
              "elasticsearch/index/alias/update"
            ],
            "effect": "write",
            "params": {
              "actions": {
                "source": "input",
                "path": "/actions",
                "type": "json"
              }
            }
          },
          "count": {
            "mode": "invoke",
            "method": "elasticsearch/count",
            "requires": [
              "elasticsearch/count"
            ],
            "effect": "read",
            "params": {
              "query": {
                "source": "input",
                "path": "/query",
                "type": "string"
              }
            }
          },
          "documentGet": {
            "mode": "invoke",
            "method": "elasticsearch/document/get",
            "requires": [
              "elasticsearch/document/get"
            ],
            "effect": "read",
            "params": {
              "name": {
                "source": "route",
                "path": "/name",
                "type": "string"
              },
              "id": {
                "source": "route",
                "path": "/id",
                "type": "string"
              }
            }
          },
          "documentIndex": {
            "mode": "invoke",
            "method": "elasticsearch/document/index",
            "requires": [
              "elasticsearch/document/index"
            ],
            "effect": "write",
            "params": {
              "name": {
                "source": "input",
                "path": "/name",
                "type": "string"
              },
              "id": {
                "source": "input",
                "path": "/id",
                "type": "string"
              },
              "body": {
                "source": "input",
                "path": "/body",
                "type": "json"
              }
            }
          },
          "documentDelete": {
            "mode": "invoke",
            "method": "elasticsearch/document/delete",
            "requires": [
              "elasticsearch/document/delete"
            ],
            "effect": "destructive",
            "params": {
              "name": {
                "source": "selection",
                "path": "/name",
                "type": "string"
              },
              "id": {
                "source": "selection",
                "path": "/id",
                "type": "string"
              }
            }
          },
          "indexSearch": {
            "mode": "invoke",
            "method": "elasticsearch/search",
            "requires": [
              "elasticsearch/search"
            ],
            "effect": "read",
            "params": {
              "name": {
                "source": "route",
                "path": "/name",
                "type": "string"
              },
              "query": {
                "source": "input",
                "path": "/query",
                "type": "string"
              },
              "size": {
                "source": "literal",
                "value": 50,
                "type": "number"
              }
            }
          },
          "indexDocuments": {
            "mode": "invoke",
            "method": "elasticsearch/search",
            "requires": [
              "elasticsearch/search"
            ],
            "effect": "read",
            "params": {
              "name": {
                "source": "route",
                "path": "/name",
                "type": "string"
              },
              "query": {
                "source": "literal",
                "value": "*",
                "type": "string"
              },
              "size": {
                "source": "literal",
                "value": 50,
                "type": "number"
              }
            }
          }
        },
        "pages": [
