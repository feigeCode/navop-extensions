              "name": {
                "source": "route",
                "path": "/name",
                "type": "string"
              }
            }
          },
          "indexMapping": {
            "mode": "invoke",
            "method": "elasticsearch/index/mapping",
            "requires": [
              "elasticsearch/index/mapping"
            ],
            "effect": "read",
            "params": {
              "name": {
                "source": "route",
                "path": "/name",
                "type": "string"
              }
            }
          },
          "indexSettings": {
            "mode": "invoke",
            "method": "elasticsearch/index/settings",
            "requires": [
              "elasticsearch/index/settings"
            ],
            "effect": "read",
            "params": {
              "name": {
                "source": "route",
                "path": "/name",
                "type": "string"
              }
            }
          },
          "indexAliases": {
            "mode": "invoke",
