            "effect": "read",
            "params": {
              "id": {
                "source": "route",
                "path": "/id",
                "type": "string"
              },
              "tail": {
                "source": "literal",
                "type": "string",
                "value": "500"
              }
            }
          },
          "containerLogsWithTail": {
            "mode": "invoke",
            "method": "docker/container/logs",
            "requires": [
              "docker/container/logs"
            ],
            "effect": "read",
            "params": {
              "id": {
                "source": "route",
                "path": "/id",
                "type": "string"
              },
              "tail": {
                "source": "input",
                "path": "/tail",
                "type": "string"
              }
            }
          },
