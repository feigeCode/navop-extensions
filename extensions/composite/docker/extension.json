{
  "schema_version": 1,
  "id": "com.navop.docker",
  "name": "Docker",
  "version": "0.4.0",
  "publisher": "Navop",
  "license": "Apache-2.0",
  "description": "Docker container, image, volume and network management through the native resource workbench.",
  "categories": [
    "containers",
    "developer-tools"
  ],
  "keywords": [
    "docker",
    "container",
    "image",
    "volume",
    "network"
  ],
  "engines": {
    "onetcli": ">=0.17.0",
    "gpui_shell": "0.2.0"
  },
  "api": {
    "extension": "1.0"
  },
  "permissions": [
    "spawn:./bin/docker-provider",
    "shell:exec",
    "net:unix:~/.docker/run/docker.sock",
    "net:unix:/var/run/docker.sock"
  ],
  "runtime": {
    "ipc": [
      {
        "id": "main",
        "entry": {
          "command": "./bin/docker-provider"
        },
        "transport": {
          "kind": "local_socket",
          "connect_timeout_ms": 5000
        },
        "auto_restart": true,
        "max_restart_attempts": 3,
        "shutdown_grace_ms": 2500
      }
    ]
  },
  "contributes": {
    "connections": [
      {
        "id": "docker-local",
        "label": "Docker",
        "description": "Connect to a local Docker daemon through its Unix socket.",
        "runtimeId": "main",
        "resourceType": "docker",
        "form": {
          "tabs": [
            {
              "id": "general",
              "label": "General",
              "fields": [
                {
                  "id": "socket",
                  "label": "Docker socket",
                  "fieldType": "Text",
                  "required": true,
                  "defaultValue": "unix://~/.docker/run/docker.sock",
                  "placeholder": "unix:///var/run/docker.sock"
                }
              ]
            }
          ]
        }
      }
    ],
    "shellViews": [
      {
        "id": "log-viewer",
        "title": "Docker Log Viewer",
        "description": "Container log reader with tail control, embedded in the native workbench.",
        "entry": "ui/log-viewer.js",
        "surface": "tab",
        "singleton": false,
        "backends": {
          "docker": "main"
        },
        "modules": [
          "context",
          "workbench"
        ]
      }
    ],
    "resourceWorkbenches": [
      {
        "schemaVersion": 1,
        "id": "docker",
        "title": "Docker",
        "connectionIds": [
          "docker-local"
        ],
        "runtimeId": "main",
        "resourceType": "docker",
        "defaultPage": "containers",
        "statusBar": {
          "operation": "systemUsage"
        },
        "operations": {
          "systemInfo": {
            "mode": "invoke",
            "method": "docker/system/info",
            "requires": [
              "docker/system/info"
            ],
            "effect": "read"
          },
          "systemUsage": {
            "mode": "invoke",
            "method": "docker/system/usage",
            "requires": [
              "docker/system/usage"
            ],
            "effect": "read"
          },
          "listContainers": {
            "mode": "invoke",
            "method": "docker/container/list",
            "requires": [
              "docker/container/list"
            ],
            "effect": "read"
          },
          "inspectContainer": {
            "mode": "invoke",
            "method": "docker/container/inspect",
            "requires": [
              "docker/container/inspect"
            ],
            "effect": "read",
            "params": {
              "id": {
                "source": "route",
                "path": "/id",
                "type": "string"
              }
            }
          },
          "containerMounts": {
            "mode": "invoke",
            "method": "docker/container/mounts",
            "requires": [
              "docker/container/mounts"
            ],
            "effect": "read",
            "params": {
              "id": {
                "source": "route",
                "path": "/id",
                "type": "string"
              }
            }
          },
          "containerStats": {
            "mode": "invoke",
            "method": "docker/container/stats",
            "requires": [
              "docker/container/stats"
            ],
            "effect": "read",
            "params": {
              "id": {
                "source": "route",
                "path": "/id",
                "type": "string"
              }
            }
          },
          "startContainer": {
            "mode": "invoke",
            "method": "docker/container/start",
            "requires": [
              "docker/container/start"
            ],
            "effect": "write",
            "params": {
              "id": {
                "source": "selection",
                "path": "/id",
                "type": "string"
              }
            }
          },
          "stopContainer": {
            "mode": "invoke",
            "method": "docker/container/stop",
            "requires": [
              "docker/container/stop"
            ],
            "effect": "write",
            "params": {
              "id": {
                "source": "selection",
                "path": "/id",
                "type": "string"
              }
            }
          },
          "restartContainer": {
            "mode": "invoke",
