{
  "schema_version": 1,
  "id": "com.navop.docker",
  "name": "Docker",
  "version": "0.6.3",
  "publisher": "Navop",
  "license": "Apache-2.0",
  "description": "基于 Rust 原生资源后端（native resource provider）的 Docker 管理扩展：支持本地 docker.sock 与远程 TCP/TLS 守护进程（Windows 上仅支持远程 TCP/TLS），提供引擎概览、镜像管理与异步镜像拉取，并附日志查看、容器进程与文件系统变更视图及 exec 终端。 Rust-native Docker management composite extension that talks to a local docker socket or a remote TCP/TLS daemon (remote TCP/TLS only on Windows), providing engine overview, image management with asynchronous pulls, plus log viewer, container process and filesystem change views, and exec terminals.",
  "categories": [
    "containers",
    "developer-tools"
  ],
  "keywords": [
    "docker",
    "container",
    "image",
    "volume",
    "network"
  ],
  "engines": {
    "onetcli": ">=0.17.0",
    "gpui_shell": "0.6.4",
    "nsh": "0.3.0"
  },
  "api": {
    "extension": "1.0"
  },
  "permissions": [
    "spawn:./bin/docker-provider",
    "shell:exec",
    "net:unix:~/.docker/run/docker.sock",
    "net:unix:/var/run/docker.sock"
  ],
  "runtime": {
    "ipc": [
      {
        "id": "main",
        "entry": {
          "command": "./bin/docker-provider"
        },
        "transport": {
          "kind": "local_socket",
          "connect_timeout_ms": 5000
        },
        "auto_restart": true,
        "max_restart_attempts": 3,
        "shutdown_grace_ms": 2500
      }
    ]
  },
  "contributes": {
    "connections": [
      {
        "id": "docker-local",
        "label": "Docker",
        "description": "Connect to a local or remote Docker daemon over a Unix socket, plain TCP, or TLS. Unix sockets are macOS/Linux only — on Windows, use Remote (TCP / TLS).",
        "icon": "icons/docker-color.svg",
        "runtimeId": "main",
        "resourceType": "docker",
        "form": {
          "tabs": [
            {
              "id": "general",
              "label": "General",
              "fields": [
                {
                  "id": "mode",
                  "label": "Connection",
                  "fieldType": "Select",
                  "required": true,
                  "defaultValue": "local",
                  "options": [
                    {
                      "value": "local",
                      "label": "Local (Unix socket, macOS / Linux)"
                    },
                    {
                      "value": "remote",
                      "label": "Remote (TCP / TLS)"
                    }
                  ]
                },
                {
                  "id": "socket",
                  "label": "Docker socket",
                  "fieldType": "Text",
                  "required": true,
                  "defaultValue": "unix://~/.docker/run/docker.sock",
                  "placeholder": "unix:///var/run/docker.sock",
                  "visibleWhen": [
                    {
                      "field": "mode",
                      "equals": "local"
                    }
                  ]
                },
                {
                  "id": "tcp_host",
                  "label": "Host",
                  "fieldType": "Text",
                  "required": true,
                  "placeholder": "192.168.1.10 or docker.example.com",
                  "visibleWhen": [
                    {
                      "field": "mode",
                      "equals": "remote"
                    }
                  ]
                },
                {
                  "id": "tcp_port",
                  "label": "Port",
                  "fieldType": "Text",
                  "placeholder": "2375 plain / 2376 TLS",
                  "visibleWhen": [
                    {
                      "field": "mode",
                      "equals": "remote"
                    }
                  ]
                },
                {
                  "id": "secure",
                  "label": "Security",
                  "fieldType": "Select",
                  "required": true,
                  "defaultValue": "plain",
                  "options": [
                    {
                      "value": "plain",
                      "label": "Plain TCP (no TLS)"
                    },
                    {
                      "value": "tls",
                      "label": "TLS (client certificates)"
                    }
                  ],
                  "visibleWhen": [
                    {
                      "field": "mode",
                      "equals": "remote"
                    }
                  ]
                },
                {
                  "id": "cert_dir",
                  "label": "Certificate directory",
                  "fieldType": "FilePath",
                  "defaultValue": "~/.docker",
                  "placeholder": "~/.docker (ca.pem / cert.pem / key.pem)",
                  "visibleWhen": [
                    {
                      "field": "secure",
                      "equals": "tls"
                    }
                  ]
                }
              ]
            }
          ]
        },
        "route": "containers"
      }
    ],
    "shellApp": {
      "title": "Docker",
      "description": "Docker 容器管理：容器、镜像、卷、网络，以及日志、进程、挂载、统计与终端等单点视图。",
      "icon": "icons/docker-color.svg",
      "entry": "ui/dist/bundle.js",
      "category": "container",
      "keywords": [
        "docker",
        "container",
        "image",
        "volume",
        "network"
      ],
      "backends": {
        "docker": "main"
      },
      "modules": [
        "resource"
      ]
    }
  }
}
