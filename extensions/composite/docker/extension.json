{
  "schema_version": 1,
  "id": "com.navop.docker",
  "name": "Docker",
  "version": "0.1.0",
  "publisher": "Navop",
  "license": "Apache-2.0",
  "description": "Read-only Docker management through the native resource workbench.",
  "categories": ["containers", "developer-tools"],
  "keywords": ["docker", "container", "image"],
  "engines": {"onetcli": ">=0.17.0"},
  "api": {"extension": "1.0"},
  "permissions": [
    "spawn:./bin/docker-provider",
    "net:unix:~/.docker/run/docker.sock",
    "net:unix:/var/run/docker.sock"
  ],
  "runtime": {
    "ipc": [{
      "id": "main",
      "entry": {"command": "./bin/docker-provider"},
      "transport": {"kind": "local_socket", "connect_timeout_ms": 5000},
      "auto_restart": true,
      "max_restart_attempts": 3,
      "shutdown_grace_ms": 2500
    }]
  },
  "contributes": {
    "connections": [{
      "id": "docker-local",
      "label": "Docker",
      "description": "Connect to a local Docker daemon through its Unix socket.",
      "runtimeId": "main",
      "resourceType": "docker",
      "form": {
        "tabs": [{
          "id": "general",
          "label": "General",
          "fields": [{
            "id": "socket",
            "label": "Docker socket",
            "fieldType": "Text",
            "required": true,
            "defaultValue": "unix://~/.docker/run/docker.sock",
            "placeholder": "unix:///var/run/docker.sock"
          }]
        }]
      }
    }],
    "resourceWorkbenches": [{
      "schemaVersion": 1,
      "id": "docker",
      "title": "Docker",
      "connectionIds": ["docker-local"],
      "runtimeId": "main",
      "resourceType": "docker",
      "defaultPage": "overview",
      "operations": {
        "systemInfo": {
          "mode": "invoke",
          "method": "docker/system/info",
          "requires": ["docker/system/info"],
          "effect": "read"
        },
        "listContainers": {
          "mode": "invoke",
          "method": "docker/container/list",
          "requires": ["docker/container/list"],
          "effect": "read"
        },
        "inspectContainer": {
          "mode": "invoke",
          "method": "docker/container/inspect",
          "requires": ["docker/container/inspect"],
          "effect": "read",
          "params": {
            "id": {"source": "route", "path": "/id", "type": "string"}
          }
        }
      },
      "navigation": [
        {"pageId": "overview"},
        {"pageId": "containers"}
      ],
      "tree": [{
        "id": "containers",
        "title": "Containers",
        "pageId": "containers",
        "children": {
          "operation": "listContainers",
          "itemsPath": "/containers",
          "keyPaths": ["/id"],
          "labelPath": "/name"
        }
      }],
      "pages": [
        {
          "id": "overview",
          "title": "Docker Overview",
          "template": "json",
          "renderer": {"kind": "native"},
          "load": {"operation": "systemInfo"}
        },
        {
          "id": "containers",
          "title": "Containers",
          "template": "collection",
          "renderer": {"kind": "native"},
          "load": {"operation": "listContainers"},
          "collection": {
            "itemsPath": "/containers",
            "keyPaths": ["/id"],
            "pagination": {"kind": "none"},
            "columns": [
              {"id": "name", "title": "Name", "path": "/name", "type": "string"},
              {"id": "image", "title": "Image", "path": "/image", "type": "display"},
              {"id": "state", "title": "State", "path": "/state", "type": "display"},
              {"id": "status", "title": "Status", "path": "/status", "type": "display"}
            ],
            "open": {
              "pageId": "container-detail",
              "route": {
                "id": {"source": "selection", "path": "/id", "type": "string"}
              }
            }
          }
        },
        {
          "id": "container-detail",
          "title": "Container",
          "template": "json",
          "renderer": {"kind": "native"},
          "route": {"id": {"type": "string", "required": true}},
          "load": {"operation": "inspectContainer"}
        }
      ]
    }]
  }
}
