{
  "schema_version": 1,
  "id": "com.navop.middleware.rocketmq",
  "kind": "composite",
  "name": "RocketMQ",
  "version": "0.1.0",
  "publisher": "Navop",
  "license": "Apache-2.0",
  "description": "RocketMQ 中间件管理扩展：Remoting 私有协议直连 NameServer/Broker，提供集群概览、Topic 管理、订阅组与客户端、消息查询与发送。 RocketMQ middleware extension speaking the native Remoting protocol, with cluster overview, topic management, consumer groups and clients, message query and send.",
  "categories": [
    "middleware",
    "message-queue",
    "developer-tools"
  ],
  "keywords": [
    "rocketmq",
    "message-queue",
    "nameserver",
    "broker",
    "topic",
    "consumer-group"
  ],
  "engines": {
    "onetcli": ">=0.17.0",
    "gpui_shell": "0.2.0"
  },
  "api": {
    "extension": "1.0",
    "shell": "1.0"
  },
  "permissions": [
    "shell:exec",
    "spawn:./bin/rocketmq-provider",
    "net:tcp:*:9876",
    "net:tcp:*:10911",
    "secrets:read:self.*"
  ],
  "runtime": {
    "ipc": [
      {
        "id": "main",
        "entry": {
          "command": "./bin/rocketmq-provider"
        },
        "transport": {
          "kind": "local_socket",
          "connect_timeout_ms": 5000
        },
        "auto_restart": true,
        "max_restart_attempts": 3,
        "shutdown_grace_ms": 2500
      }
    ]
  },
  "contributes": {
    "connections": [
      {
        "id": "rocketmq",
        "label": "RocketMQ",
        "description": "连接 RocketMQ 集群，管理 Topic、订阅组与消息。",
        "runtimeId": "main",
        "resourceType": "middleware",
        "shellViewId": "console",
        "form": {
          "tabs": [
            {
              "id": "general",
              "label": "常规",
              "fields": [
                {
                  "id": "namesrv_addrs",
                  "label": "NameServer 地址",
                  "fieldType": "Text",
                  "required": true,
                  "placeholder": "127.0.0.1:9876;10.0.0.2:9876"
                }
              ]
            },
            {
              "id": "advanced",
              "label": "高级",
              "fields": [
                {
                  "id": "acl_enabled",
                  "label": "ACL 认证",
                  "fieldType": "Select",
                  "required": true,
                  "defaultValue": "none",
                  "options": [
                    {
                      "value": "none",
                      "label": "无"
                    },
                    {
                      "value": "rocketmq",
                      "label": "RocketMQ ACL"
                    }
                  ]
                },
                {
                  "id": "access_key",
                  "label": "AccessKey",
                  "fieldType": "Text",
                  "required": true,
                  "visibleWhen": [
                    {
                      "field": "acl_enabled",
                      "equals": "rocketmq"
                    }
                  ]
                },
                {
                  "id": "secret_key",
                  "label": "SecretKey",
                  "fieldType": "Password",
                  "required": true,
                  "secret": true,
                  "visibleWhen": [
                    {
                      "field": "acl_enabled",
                      "equals": "rocketmq"
                    }
                  ]
                },
                {
                  "id": "timeout_ms",
                  "label": "超时(毫秒)",
                  "fieldType": "Number",
                  "required": true,
                  "defaultValue": "5000"
                }
              ]
            }
          ]
        },
        "icon": "icons/rocketmq-color.svg"
      }
    ],
    "resourceWorkbenches": [
      {
        "schemaVersion": 1,
        "id": "rocketmq",
        "title": "RocketMQ",
        "connectionIds": ["rocketmq"],
        "runtimeId": "main",
        "resourceType": "middleware",
        "defaultPage": "overview",
        "operations": {
          "clusterOverview": {
            "mode": "invoke",
            "method": "middleware/cluster/overview",
            "requires": ["middleware/cluster/overview"],
            "effect": "read"
          },
          "listTopics": {
            "mode": "invoke",
            "method": "middleware/topic/list",
            "requires": ["middleware/topic/list"],
            "effect": "read"
          },
          "topicDetail": {
            "mode": "invoke",
            "method": "middleware/topic/detail",
            "requires": ["middleware/topic/detail"],
            "effect": "read",
            "params": {
              "topic": {"source": "route", "path": "/topic", "type": "string"}
            }
          },
          "listGroups": {
            "mode": "invoke",
            "method": "middleware/group/list",
            "requires": ["middleware/group/list"],
            "effect": "read"
          },
          "groupDetail": {
            "mode": "invoke",
            "method": "middleware/group/detail",
            "requires": ["middleware/group/detail"],
            "effect": "read",
            "params": {
              "group": {"source": "route", "path": "/group", "type": "string"}
            }
          },
          "createTopic": {
            "mode": "invoke",
            "method": "middleware/topic/create",
            "requires": ["middleware/topic/create"],
            "effect": "write",
            "params": {
              "topic": {"source": "input", "path": "/topic", "type": "string"},
              "queueCount": {"source": "input", "path": "/queueCount", "type": "number"}
            }
          },
          "deleteTopic": {
            "mode": "invoke",
            "method": "middleware/topic/delete",
            "requires": ["middleware/topic/delete"],
            "effect": "destructive",
            "params": {
              "topic": {"source": "input", "path": "/topic", "type": "string"}
            }
          },
          "sendMessage": {
            "mode": "invoke",
            "method": "middleware/message/send",
            "requires": ["middleware/message/send"],
            "effect": "write",
            "params": {
              "topic": {"source": "input", "path": "/topic", "type": "string"},
              "tag": {"source": "input", "path": "/tag", "type": "string"},
              "key": {"source": "input", "path": "/key", "type": "string"},
              "body": {"source": "input", "path": "/body", "type": "json"}
            }
          }
        },
        "navigation": [
          {"pageId": "overview"},
          {"pageId": "topics"},
          {"pageId": "groups"},
          {"pageId": "send-message"},
          {"pageId": "create-topic"},
          {"pageId": "delete-topic"}
        ],
        "tree": [
          {
            "id": "topics",
            "title": "Topics",
            "pageId": "topics",
            "children": {
              "operation": "listTopics",
              "itemsPath": "/topics",
              "keyPaths": ["/name"],
              "labelPath": "/name"
            }
          },
          {
            "id": "groups",
            "title": "Groups",
            "pageId": "groups",
            "children": {
              "operation": "listGroups",
              "itemsPath": "/groups",
              "keyPaths": ["/group"],
              "labelPath": "/group"
            }
          }
        ],
        "pages": [
          {
            "id": "overview",
            "title": "Overview",
            "template": "json",
            "renderer": {"kind": "native"},
            "load": {"operation": "clusterOverview"}
          },
          {
            "id": "topics",
            "title": "Topics",
            "template": "collection",
            "renderer": {"kind": "native"},
            "load": {"operation": "listTopics"},
            "collection": {
              "itemsPath": "/topics",
              "keyPaths": ["/name"],
              "pagination": {"kind": "none"},
              "columns": [
                {"id": "name", "title": "Topic", "path": "/name", "type": "string"},
                {"id": "type", "title": "Type", "path": "/topic_type", "type": "display"},
                {"id": "queues", "title": "Queues", "path": "/queue_count", "type": "display"},
                {"id": "messages", "title": "Messages", "path": "/message_count", "type": "display"}
              ],
              "open": {
                "pageId": "topic-detail",
                "route": {
                  "topic": {"source": "selection", "path": "/name", "type": "string"}
                }
              }
            }
          },
          {
            "id": "topic-detail",
            "title": "Topic",
            "template": "json",
            "renderer": {"kind": "native"},
            "route": {"topic": {"type": "string", "required": true}},
            "load": {"operation": "topicDetail"}
          },
          {
            "id": "groups",
            "title": "Groups",
            "template": "collection",
            "renderer": {"kind": "native"},
            "load": {"operation": "listGroups"},
            "collection": {
              "itemsPath": "/groups",
              "keyPaths": ["/group"],
              "pagination": {"kind": "none"},
              "columns": [
                {"id": "group", "title": "Group", "path": "/group", "type": "string"},
                {"id": "clients", "title": "Clients", "path": "/client_count", "type": "display"},
                {"id": "consumeType", "title": "Consume Type", "path": "/consume_type", "type": "display"},
                {"id": "tps", "title": "TPS", "path": "/tps", "type": "display"}
              ],
              "open": {
                "pageId": "group-detail",
                "route": {
                  "group": {"source": "selection", "path": "/group", "type": "string"}
                }
              }
            }
          },
          {
            "id": "group-detail",
            "title": "Group",
            "template": "json",
            "renderer": {"kind": "native"},
            "route": {"group": {"type": "string", "required": true}},
            "load": {"operation": "groupDetail"}
          },
          {
            "id": "create-topic",
            "title": "Create Topic",
            "template": "query",
            "renderer": {"kind": "native"},
            "inputs": [
              {"id": "topic", "type": "string", "editor": "text", "required": true},
              {"id": "queueCount", "type": "number", "editor": "text", "default": "4", "required": true}
            ],
            "execute": {"operation": "createTopic"}
          },
          {
            "id": "delete-topic",
            "title": "Delete Topic",
            "template": "query",
            "renderer": {"kind": "native"},
            "inputs": [
              {"id": "topic", "type": "string", "editor": "text", "required": true}
            ],
            "execute": {"operation": "deleteTopic"}
          },
          {
            "id": "send-message",
            "title": "Send Message",
            "template": "json",
            "renderer": {"kind": "shell", "viewId": "send-message"}
          }
        ]
      }
    ],
    "shellViews": [
      {
        "id": "send-message",
        "title": "RocketMQ Message Sender",
        "description": "Send a message to a topic through the unified workbench dispatcher.",
        "entry": "ui/send-message.js",
        "surface": "tab",
        "singleton": false,
        "backends": {
          "resource": "main"
        },
        "modules": ["context", "workbench"]
      },
      {
        "id": "console",
        "title": "RocketMQ",
        "description": "RocketMQ 中间件控制台：概览、Topic、订阅组与客户端、消息查询。",
        "entry": "ui/console.js",
        "surface": "tab",
        "singleton": false,
        "backends": {
          "resource": "main"
        },
        "modules": [
          "context",
          "resource",
          "job",
          "event",
          "blob",
          "runtime",
          "log"
        ],
        "icon": "icons/rocketmq-color.svg"
      }
    ]
  }
}