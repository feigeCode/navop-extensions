            "requires": [
              "middleware/topic/create"
            ],
            "effect": "write",
            "params": {
              "topic": {
                "source": "input",
                "path": "/topic",
                "type": "string"
              },
              "queue_count": {
                "source": "input",
                "path": "/queue_count",
                "type": "number"
              },
              "perm": {
                "source": "input",
                "path": "/perm",
                "type": "string"
              }
            }
          },
          "updateTopic": {
            "mode": "invoke",
            "method": "middleware/topic/update",
            "requires": [
              "middleware/topic/update"
            ],
            "effect": "write",
            "params": {
              "topic": {
                "source": "input",
                "path": "/topic",
                "type": "string"
              },
              "queue_count": {
                "source": "input",
                "path": "/queue_count",
                "type": "number"
              },
              "perm": {
                "source": "input",
                "path": "/perm",
                "type": "string"
              }
            }
          },
          "deleteTopic": {
            "mode": "invoke",
            "method": "middleware/topic/delete",
            "requires": [
              "middleware/topic/delete"
            ],
            "effect": "destructive",
            "params": {
              "topic": {
                "source": "selection",
                "path": "/name",
                "type": "string"
              }
            }
          },
          "listGroups": {
            "mode": "invoke",
            "method": "middleware/group/list",
            "requires": [
              "middleware/group/list"
            ],
            "effect": "read"
          },
          "groupDetail": {
            "mode": "invoke",
            "method": "middleware/group/detail",
            "requires": [
              "middleware/group/detail"
            ],
            "effect": "read",
            "params": {
              "group": {
                "source": "route",
                "path": "/group",
                "type": "string"
              }
            }
          },
          "groupClients": {
            "mode": "invoke",
            "method": "middleware/group/clients",
            "requires": [
              "middleware/group/clients"
            ],
            "effect": "read",
            "params": {
              "group": {
                "source": "route",
                "path": "/group",
                "type": "string"
              }
            }
          },
          "queryByTimeWindow": {
            "mode": "invoke",
            "method": "middleware/message/query",
            "requires": [
              "middleware/message/query"
            ],
            "effect": "read",
            "params": {
              "ByTimeWindow": {
                "source": "input",
                "path": "/ByTimeWindow",
                "type": "json"
              }
            }
          },
          "queryByKey": {
            "mode": "invoke",
            "method": "middleware/message/query",
            "requires": [
              "middleware/message/query"
            ],
            "effect": "read",
            "params": {
              "ByKey": {
                "source": "input",
                "path": "/ByKey",
                "type": "json"
              }
            }
          },
          "queryById": {
            "mode": "invoke",
            "method": "middleware/message/query",
            "requires": [
              "middleware/message/query"
            ],
            "effect": "read",
            "params": {
              "ById": {
                "source": "input",
                "path": "/ById",
                "type": "json"
              }
            }
          },
          "sendMessage": {
            "mode": "invoke",
            "method": "middleware/message/send",
            "requires": [
              "middleware/message/send"
            ],
            "effect": "write",
            "params": {
              "topic": {
                "source": "input",
                "path": "/topic",
                "type": "string"
              },
              "tag": {
                "source": "input",
                "path": "/tag",
                "type": "string"
              },
              "key": {
                "source": "input",
                "path": "/key",
                "type": "string"
              },
              "body": {
                "source": "input",
                "path": "/body",
                "type": "json"
              }
            }
          },
          "resetConsumerOffset": {
            "mode": "invoke",
