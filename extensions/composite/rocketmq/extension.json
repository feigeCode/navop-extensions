{
  "schema_version": 1,
  "id": "com.navop.middleware.rocketmq",
  "kind": "composite",
  "name": "RocketMQ",
  "version": "0.1.0",
  "publisher": "Navop",
  "license": "Apache-2.0",
  "description": "RocketMQ 中间件管理扩展（Rust 原生 provider）：Remoting 私有协议直连 NameServer/Broker，提供集群概览、Topic 管理、订阅组与客户端、消息查询与发送、协议错误处理与 admin 操作。 Native Rust RocketMQ middleware extension speaking the Remoting protocol directly to NameServer/Broker, with cluster overview, topic management, consumer groups and clients, message query and send, protocol error handling, and admin operations.",
  "categories": [
    "middleware",
    "message-queue",
    "developer-tools"
  ],
  "keywords": [
    "rocketmq",
    "message-queue",
    "nameserver",
    "broker",
    "topic",
    "consumer-group"
  ],
  "engines": {
    "onetcli": ">=0.17.0",
    "gpui_shell": "0.2.0"
  },
  "api": {
    "extension": "1.0",
    "shell": "1.0"
  },
  "permissions": [
    "shell:exec",
    "spawn:./bin/rocketmq-provider",
    "net:tcp:*:9876",
    "net:tcp:*:10911",
    "secrets:read:self.*"
  ],
  "runtime": {
    "ipc": [
      {
        "id": "main",
        "entry": {
          "command": "./bin/rocketmq-provider"
        },
        "transport": {
          "kind": "local_socket",
          "connect_timeout_ms": 5000
        },
        "auto_restart": true,
        "max_restart_attempts": 3,
        "shutdown_grace_ms": 2500
      }
    ]
  },
  "contributes": {
    "connections": [
      {
        "id": "rocketmq",
        "label": "RocketMQ",
        "description": "连接 RocketMQ 集群，管理 Topic、订阅组与消息。",
        "runtimeId": "main",
        "resourceType": "middleware",
        "form": {
          "tabs": [
            {
              "id": "general",
              "label": "常规",
              "fields": [
                {
                  "id": "namesrv_addrs",
                  "label": "NameServer 地址",
                  "fieldType": "Text",
                  "required": true,
                  "placeholder": "127.0.0.1:9876;10.0.0.2:9876"
                }
              ]
            },
            {
              "id": "advanced",
              "label": "高级",
              "fields": [
                {
                  "id": "acl_enabled",
                  "label": "ACL 认证",
                  "fieldType": "Select",
                  "required": true,
                  "defaultValue": "none",
                  "options": [
                    {
                      "value": "none",
                      "label": "无"
                    },
                    {
                      "value": "rocketmq",
                      "label": "RocketMQ ACL"
                    }
                  ]
                },
                {
                  "id": "access_key",
                  "label": "AccessKey",
                  "fieldType": "Text",
                  "required": true,
                  "visibleWhen": [
                    {
                      "field": "acl_enabled",
                      "equals": "rocketmq"
                    }
                  ]
                },
                {
                  "id": "secret_key",
                  "label": "SecretKey",
                  "fieldType": "Password",
                  "required": true,
                  "secret": true,
                  "visibleWhen": [
                    {
                      "field": "acl_enabled",
                      "equals": "rocketmq"
                    }
                  ]
                },
                {
                  "id": "timeout_ms",
                  "label": "超时(毫秒)",
                  "fieldType": "Number",
                  "required": true,
                  "defaultValue": "5000"
                }
              ]
            }
          ]
        },
        "icon": "icons/rocketmq-color.svg"
      }
    ],
    "resourceWorkbenches": [
      {
        "schemaVersion": 3,
        "id": "rocketmq",
        "title": "RocketMQ",
        "connectionIds": [
          "rocketmq"
        ],
        "runtimeId": "main",
        "resourceType": "middleware",
        "defaultPage": "overview",
        "operations": {
          "metrics": {
