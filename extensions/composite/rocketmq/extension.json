                    "default": "4",
                    "required": true,
                    "label": "队列数",
                    "description": "单 Broker 的写队列数量，扩容时填目标值"
                  },
                  {
                    "id": "perm",
                    "type": "string",
                    "editor": "select",
                    "default": "6",
                    "required": true,
                    "label": "读写权限",
