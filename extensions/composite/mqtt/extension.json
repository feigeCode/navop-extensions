{
  "schema_version": 1,
  "kind": "composite",
  "id": "com.navop.middleware.mqtt",
  "name": "MQTT",
  "version": "0.1.0",
  "publisher": "Navop",
  "license": "Apache-2.0",
  "description": "面向 MQTT 3.1.1 的中间件管理扩展，支持订阅浏览、本地消息缓冲查询、消息发送与收发指标。 Native MQTT 3.1.1 middleware extension with subscription browsing, buffered message query, message publishing, and traffic metrics.",
  "categories": ["middleware", "messaging", "developer-tools"],
  "keywords": ["mqtt", "middleware", "iot", "messaging", "pubsub"],
  "engines": {
    "onetcli": ">=0.15.2",
    "gpui_shell": "0.2.0"
  },
  "api": {
    "extension": "1.0",
    "shell": "1.0"
  },
  "permissions": [
    "spawn:./bin/mqtt-provider",
    "net:tcp:*:1883",
    "net:tcp:*:8883",
    "secrets:read:self.*"
  ],
  "runtime": {
    "ipc": [
      {
        "id": "main",
        "entry": {
          "command": "./bin/mqtt-provider"
        },
        "transport": {
          "kind": "local_socket",
          "connect_timeout_ms": 5000
        },
        "auto_restart": true,
        "max_restart_attempts": 3,
        "shutdown_grace_ms": 2500
      }
    ]
  },
  "contributes": {
    "connections": [
      {
        "id": "mqtt",
        "label": "MQTT",
        "description": "连接 MQTT Broker，管理订阅与消息查询。",
        "runtimeId": "main",
        "resourceType": "middleware",
        "shellViewId": "console",
        "form": {
          "tabs": [
            {
              "id": "general",
              "label": "常规",
              "fields": [
                {
                  "id": "host",
                  "label": "主机",
                  "fieldType": "Text",
                  "required": true,
                  "defaultValue": "127.0.0.1",
                  "placeholder": "127.0.0.1"
                },
                {
                  "id": "port",
                  "label": "端口",
                  "fieldType": "Number",
                  "required": true,
                  "defaultValue": "1883",
                  "placeholder": "1883"
                },
                {
                  "id": "username",
                  "label": "用户名",
                  "fieldType": "Text"
                },
                {
                  "id": "password",
                  "label": "密码",
                  "fieldType": "Password",
                  "secret": true
                },
                {
                  "id": "client_id",
                  "label": "客户端 ID",
                  "fieldType": "Text",
                  "placeholder": "留空自动生成 navop-mqtt-<随机后缀>"
                },
                {
                  "id": "keep_alive_secs",
                  "label": "心跳间隔(秒)",
                  "fieldType": "Number",
                  "defaultValue": "60"
                }
              ]
            }
          ]
        }
      }
    ],
    "shellViews": [
      {
        "id": "console",
        "title": "MQTT",
        "description": "浏览 MQTT 订阅，查询缓冲消息，发送消息并查看收发指标。",
        "entry": "ui/console.js",
        "surface": "tab",
        "singleton": false,
        "backends": {
          "resource": "main"
        },
        "modules": [
          "context",
          "resource",
          "job",
          "event",
          "blob",
          "runtime",
          "log"
        ]
      }
    ]
  }
}
