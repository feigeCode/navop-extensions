{
  "schema_version": 1,
  "kind": "composite",
  "id": "com.navop.middleware.mqtt",
  "name": "MQTT",
  "version": "0.2.0",
  "publisher": "Navop",
  "license": "Apache-2.0",
  "description": "MQTT 3.1.1 客户端工作台（Rust 原生 provider）：连接概览、订阅管理、实时/历史消息浏览、消息发布、TLS 与遗嘱配置。 Native Rust MQTT 3.1.1 client workbench: connection overview, subscription management, live/history message browser, publisher, TLS and last-will support.",
  "categories": [
    "middleware",
    "messaging",
    "developer-tools"
  ],
  "keywords": [
    "mqtt",
    "middleware",
    "iot",
    "messaging",
    "pubsub"
  ],
  "engines": {
    "onetcli": ">=0.17.0",
    "gpui_shell": "0.2.0"
  },
  "api": {
    "extension": "1.0",
    "shell": "1.0"
  },
  "permissions": [
    "shell:exec",
    "spawn:./bin/mqtt-provider",
    "net:tcp:*:1883",
    "net:tcp:*:8883",
    "secrets:read:self.*"
  ],
  "runtime": {
    "ipc": [
      {
        "id": "main",
        "entry": {
          "command": "./bin/mqtt-provider"
        },
        "transport": {
          "kind": "local_socket",
          "connect_timeout_ms": 5000
        },
        "auto_restart": true,
        "max_restart_attempts": 3,
        "shutdown_grace_ms": 2500
      }
    ]
  },
  "contributes": {
    "connections": [
      {
        "id": "mqtt",
        "label": "MQTT",
        "description": "连接 MQTT Broker，管理订阅、浏览与发布消息。",
        "runtimeId": "main",
        "resourceType": "middleware",
        "form": {
          "tabs": [
            {
              "id": "general",
              "label": "常规",
              "fields": [
                {
                  "id": "host",
                  "label": "主机",
                  "fieldType": "Text",
                  "required": true,
                  "defaultValue": "127.0.0.1",
                  "placeholder": "broker.example.com"
                },
                {
                  "id": "port",
                  "label": "端口",
                  "fieldType": "Number",
                  "required": true,
                  "defaultValue": "1883",
                  "placeholder": "1883（TLS 通常为 8883）"
                },
                {
                  "id": "use_tls",
                  "label": "启用 TLS（使用系统根证书）",
                  "fieldType": "Checkbox",
                  "defaultValue": "false"
                },
                {
                  "id": "username",
                  "label": "用户名",
                  "fieldType": "Text"
                },
                {
                  "id": "password",
                  "label": "密码",
                  "fieldType": "Password",
                  "secret": true
                }
              ]
            },
            {
              "id": "session",
              "label": "会话",
              "fields": [
                {
                  "id": "client_id",
                  "label": "客户端 ID",
                  "fieldType": "Text",
                  "placeholder": "留空自动生成 navop-mqtt-<随机后缀>"
                },
                {
                  "id": "keep_alive_secs",
                  "label": "心跳间隔(秒)",
                  "fieldType": "Number",
                  "defaultValue": "60"
                },
                {
                  "id": "clean_session",
                  "label": "Clean Session（断开后不保留会话）",
                  "fieldType": "Checkbox",
                  "defaultValue": "true"
                },
                {
                  "id": "auto_subscribe",
                  "label": "连接后自动订阅",
                  "fieldType": "Text",
                  "defaultValue": "#",
                  "placeholder": "主题过滤器，留空则不自动订阅"
                }
              ]
            },
            {
              "id": "will",
              "label": "遗嘱",
              "fields": [
                {
                  "id": "will_topic",
                  "label": "遗嘱主题",
                  "fieldType": "Text",
                  "placeholder": "留空则不设置遗嘱"
                },
                {
                  "id": "will_payload",
                  "label": "遗嘱内容",
                  "fieldType": "TextArea"
                },
                {
                  "id": "will_qos",
                  "label": "遗嘱 QoS",
                  "fieldType": "Select",
                  "defaultValue": "0",
                  "options": [
                    {
                      "value": "0",
                      "label": "QoS 0 - At most once"
                    },
                    {
                      "value": "1",
                      "label": "QoS 1 - At least once"
                    },
                    {
                      "value": "2",
                      "label": "QoS 2 - Exactly once"
                    }
                  ]
                },
                {
                  "id": "will_retain",
                  "label": "遗嘱保留(Retain)",
                  "fieldType": "Checkbox",
                  "defaultValue": "false"
                }
              ]
            }
          ]
        },
        "icon": "icons/mqtt-color.svg"
      }
    ],
    "resourceWorkbenches": [
      {
        "schemaVersion": 3,
        "id": "mqtt",
        "title": "MQTT",
        "connectionIds": [
          "mqtt"
        ],
        "runtimeId": "main",
        "resourceType": "middleware",
        "defaultPage": "messages",
        "operations": {
          "metrics": {
            "mode": "invoke",
            "method": "middleware/metrics",
            "requires": [
              "middleware/metrics"
            ],
            "effect": "read"
          },
          "listTopics": {
            "mode": "invoke",
            "method": "middleware/topic/list",
            "requires": [
              "middleware/topic/list"
            ],
            "effect": "read"
          },
          "listClients": {
            "mode": "invoke",
            "method": "middleware/group/clients",
            "requires": [
              "middleware/group/clients"
            ],
            "effect": "read",
            "params": {
              "group": {
                "source": "literal",
                "path": "/group",
                "type": "string",
                "value": "local"
              }
            }
          },
          "subscribe": {
            "mode": "invoke",
            "method": "middleware/topic/create",
            "requires": [
              "middleware/topic/create"
            ],
            "effect": "write",
            "params": {
              "topic": {
                "source": "input",
                "path": "/topic",
                "type": "string"
              },
              "queue_count": {
                "source": "input",
                "path": "/qos",
                "type": "number"
              }
            }
          },
          "unsubscribe": {
            "mode": "invoke",
            "method": "middleware/topic/delete",
            "requires": [
              "middleware/topic/delete"
            ],
            "effect": "destructive",
            "params": {
              "topic": {
                "source": "input",
                "path": "/topic",
                "type": "string"
              }
            }
          },
          "publish": {
            "mode": "invoke",
            "method": "middleware/message/send",
            "requires": [
              "middleware/message/send"
            ],
            "effect": "write",
            "params": {
              "topic": {
                "source": "input",
                "path": "/topic",
                "type": "string"
              },
              "body": {
                "source": "input",
                "path": "/body",
                "type": "json"
              },
              "properties": {
                "source": "input",
                "path": "/properties",
                "type": "json"
              }
            }
          },
          "queryByWindow": {
            "mode": "invoke",
            "method": "middleware/message/query",
            "requires": [
              "middleware/message/query"
            ],
            "effect": "read",
            "params": {
              "ByTimeWindow": {
                "source": "input",
                "path": "/ByTimeWindow",
                "type": "json"
              }
            }
          },
          "queryByKey": {
            "mode": "invoke",
            "method": "middleware/message/query",
            "requires": [
              "middleware/message/query"
            ],
            "effect": "read",
            "params": {
              "ByKey": {
                "source": "input",
                "path": "/ByKey",
                "type": "json"
              }
            }
          },
          "messageStream": {
            "mode": "invoke",
            "method": "middleware/message/stream",
            "requires": [
              "middleware/message/stream"
            ],
            "effect": "read"
          }
        },
        "pages": [
          {
            "id": "overview",
            "title": "概览",
            "renderer": {
              "kind": "shell",
              "viewId": "overview",
              "fallback": "native"
            },
            "load": {
              "operation": "metrics"
            },
            "stack": [
              {
                "kind": "viewer",
                "format": "json"
              }
            ]
          },
          {
            "id": "subscriptions",
            "title": "订阅",
            "renderer": {
              "kind": "shell",
              "viewId": "subscriptions",
              "fallback": "native"
            },
            "load": {
              "operation": "listTopics"
            },
            "stack": [
              {
                "kind": "table",
                "itemsPath": "/topics",
                "keyPaths": [
                  "/name"
                ],
                "pagination": {
                  "kind": "none"
                },
                "columns": [
                  {
                    "id": "name",
                    "title": "Topic Filter",
                    "path": "/name",
                    "type": "string"
                  },
                  {
                    "id": "qos",
                    "title": "QoS",
                    "path": "/queue_count",
                    "type": "display"
                  }
                ]
              }
            ]
          },
          {
            "id": "messages",
            "title": "消息",
            "renderer": {
              "kind": "shell",
              "viewId": "messages"
            },
            "stack": [
              {
                "kind": "viewer",
                "format": "json"
              }
            ]
          },
          {
            "id": "live",
            "title": "实时消息",
            "renderer": {
              "kind": "native"
            },
            "load": {
              "operation": "messageStream"
            },
            "stack": [
              {
                "kind": "stream"
              }
            ]
          },
          {
            "id": "publish",
            "title": "发布",
            "renderer": {
              "kind": "shell",
              "viewId": "publish"
            },
            "stack": [
              {
                "kind": "viewer",
                "format": "json"
              }
            ]
          }
        ],
        "layout": {
          "left": {
            "width": 180,
            "source": {
              "kind": "list",
              "items": [
                {
                  "pageId": "overview"
                },
                {
                  "pageId": "subscriptions"
                },
                {
                  "pageId": "messages"
                },
                {
                  "pageId": "live"
                },
                {
                  "pageId": "publish"
                }
              ]
            }
          },
          "center": {
            "source": {
              "kind": "pages"
            }
          }
        }
      }
    ],
    "shellViews": [
      {
        "id": "overview",
        "title": "MQTT 连接概览",
        "description": "连接信息、订阅数与收发速率指标。",
        "entry": "ui/overview.js",
        "surface": "tab",
        "singleton": false,
        "backends": {
          "resource": "main"
        },
        "modules": [
          "context",
          "workbench"
        ]
      },
      {
        "id": "subscriptions",
        "title": "MQTT 订阅管理",
        "description": "查看、新增、取消订阅主题过滤器。",
        "entry": "ui/subscriptions.js",
        "surface": "tab",
        "singleton": false,
        "backends": {
          "resource": "main"
        },
        "modules": [
          "context",
          "workbench"
        ]
      },
      {
        "id": "messages",
        "title": "MQTT 消息浏览",
        "description": "实时刷新的收发消息时间线，支持主题过滤、关键字搜索、暂停与多格式查看。",
        "entry": "ui/messages.js",
        "surface": "tab",
        "singleton": false,
        "backends": {
          "resource": "main"
        },
        "modules": [
          "context",
          "workbench"
        ]
      },
      {
        "id": "publish",
        "title": "MQTT 消息发布",
        "description": "按 QoS/Retain 发布文本、JSON、Hex 或 Base64 消息，支持重发历史。",
        "entry": "ui/publish.js",
        "surface": "tab",
        "singleton": false,
        "backends": {
          "resource": "main"
        },
        "modules": [
          "context",
          "workbench"
        ]
      }
    ]
  }
}
