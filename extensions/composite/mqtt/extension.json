{
  "schema_version": 1,
  "kind": "composite",
  "id": "com.navop.middleware.mqtt",
  "name": "MQTT",
  "version": "0.2.2",
  "publisher": "Navop",
  "license": "Apache-2.0",
  "description": "MQTT 3.1.1 客户端工作台（Rust 原生 provider）：连接概览与 Broker $SYS 指标、主题树与 retained 视图、订阅批量粘贴与收藏、实时/历史消息浏览（JSON 树与帧对比）、消息发布与压测台、自定义 CA/mTLS 与遗嘱配置。 Native Rust MQTT 3.1.1 client workbench: connection overview with broker $SYS metrics, topic tree with retained view, batch subscribe and favorites, live/history message browser with JSON tree and frame diff, publisher with load testing, custom CA/mTLS and last-will support.",
  "categories": [
    "middleware",
    "messaging",
    "developer-tools"
  ],
  "keywords": [
    "mqtt",
    "middleware",
    "iot",
    "messaging",
    "pubsub"
  ],
  "engines": {
    "onetcli": ">=0.17.0",
    "gpui_shell": "0.6.4",
    "nsh": "0.3.0"
  },
  "api": {
    "extension": "1.0",
    "shell": "1.0"
  },
  "permissions": [
    "shell:exec",
    "spawn:./bin/mqtt-provider",
    "net:tcp:*:1883",
    "net:tcp:*:8883",
    "secrets:read:self.*"
  ],
  "runtime": {
    "ipc": [
      {
        "id": "main",
        "entry": {
          "command": "./bin/mqtt-provider"
        },
        "transport": {
          "kind": "local_socket",
          "connect_timeout_ms": 5000
        },
        "auto_restart": true,
        "max_restart_attempts": 3,
        "shutdown_grace_ms": 2500
      }
    ]
  },
  "contributes": {
    "connections": [
      {
        "id": "mqtt",
        "label": "MQTT",
        "description": "连接 MQTT Broker，管理订阅、浏览与发布消息。",
        "runtimeId": "main",
        "resourceType": "middleware",
        "form": {
          "tabs": [
            {
              "id": "general",
              "label": "常规",
              "fields": [
                {
                  "id": "host",
                  "label": "主机",
                  "fieldType": "Text",
                  "required": true,
                  "defaultValue": "127.0.0.1",
                  "placeholder": "broker.example.com"
                },
                {
                  "id": "port",
                  "label": "端口",
                  "fieldType": "Number",
                  "required": true,
                  "defaultValue": "1883",
                  "placeholder": "1883（TLS 通常为 8883）"
                },
                {
                  "id": "use_tls",
                  "label": "启用 TLS",
                  "fieldType": "Checkbox",
                  "defaultValue": "false"
                },
                {
                  "id": "username",
                  "label": "用户名",
                  "fieldType": "Text"
                },
                {
                  "id": "password",
                  "label": "密码",
                  "fieldType": "Password",
                  "secret": true
                }
              ]
            },
            {
              "id": "tls",
              "label": "TLS",
              "fields": [
                {
                  "id": "tls_ca_pem",
                  "label": "CA 证书（PEM 文本）",
                  "fieldType": "TextArea",
                  "placeholder": "-----BEGIN CERTIFICATE-----…\n留空则使用系统根证书；自签证书直接贴这里即可"
                },
                {
                  "id": "tls_ca_path",
                  "label": "CA 证书文件路径",
                  "fieldType": "Text",
                  "placeholder": "/etc/mqtt/ca.pem（上面的 PEM 文本为空时才读取）"
                },
                {
                  "id": "tls_client_cert_path",
                  "label": "客户端证书路径（mTLS）",
                  "fieldType": "Text",
                  "placeholder": "/etc/mqtt/client.crt"
                },
                {
                  "id": "tls_client_key_path",
                  "label": "客户端私钥路径（mTLS）",
                  "fieldType": "Text",
                  "placeholder": "/etc/mqtt/client.key"
                },
                {
                  "id": "tls_skip_verify",
                  "label": "跳过服务端证书校验（自签调试，勿用于生产）",
                  "fieldType": "Checkbox",
                  "defaultValue": "false"
                }
              ]
            },
            {
              "id": "session",
              "label": "会话",
              "fields": [
                {
                  "id": "client_id",
                  "label": "客户端 ID",
                  "fieldType": "Text",
                  "placeholder": "留空自动生成 navop-mqtt-<随机后缀>"
                },
                {
                  "id": "keep_alive_secs",
                  "label": "心跳间隔(秒)",
                  "fieldType": "Number",
                  "defaultValue": "60"
                },
                {
                  "id": "clean_session",
                  "label": "Clean Session（断开后不保留会话）",
                  "fieldType": "Checkbox",
                  "defaultValue": "true"
                },
                {
                  "id": "auto_subscribe",
                  "label": "连接后自动订阅",
                  "fieldType": "Text",
                  "defaultValue": "#",
                  "placeholder": "主题过滤器，留空则不自动订阅"
                }
              ]
            },
            {
              "id": "will",
              "label": "遗嘱",
              "fields": [
                {
                  "id": "will_topic",
                  "label": "遗嘱主题",
                  "fieldType": "Text",
                  "placeholder": "留空则不设置遗嘱"
                },
                {
                  "id": "will_payload",
                  "label": "遗嘱内容",
                  "fieldType": "TextArea"
                },
                {
                  "id": "will_qos",
                  "label": "遗嘱 QoS",
                  "fieldType": "Select",
                  "defaultValue": "0",
                  "options": [
                    {
                      "value": "0",
                      "label": "QoS 0 - At most once"
                    },
                    {
                      "value": "1",
                      "label": "QoS 1 - At least once"
                    },
                    {
                      "value": "2",
                      "label": "QoS 2 - Exactly once"
                    }
                  ]
                },
                {
                  "id": "will_retain",
                  "label": "遗嘱保留(Retain)",
                  "fieldType": "Checkbox",
                  "defaultValue": "false"
                }
              ]
            }
          ]
        },
        "icon": "icons/mqtt-color.svg",
        "shellViewId": "messages"
      }
    ],
    "shellViews": [
      {
        "id": "overview",
        "title": "MQTT 连接概览",
        "description": "连接信息、订阅数与收发速率指标。",
        "entry": "ui/pages/overview/dist/bundle.js",
        "surface": "tab",
        "singleton": false,
        "backends": {
          "resource": "main"
        },
        "modules": [
          "context",
          "resource"
        ]
      },
      {
        "id": "subscriptions",
        "title": "MQTT 订阅管理",
        "description": "查看、新增、取消订阅主题过滤器。",
        "entry": "ui/pages/subscriptions/dist/bundle.js",
        "surface": "tab",
        "singleton": false,
        "backends": {
          "resource": "main"
        },
        "modules": [
          "context",
          "resource"
        ]
      },
      {
        "id": "messages",
        "title": "MQTT 消息浏览",
        "description": "按时间窗口与 topic 过滤查看消息时间线，支持暂停、JSON 格式化与原文切换。",
        "entry": "ui/pages/messages/dist/bundle.js",
        "surface": "tab",
        "singleton": false,
        "backends": {
          "resource": "main"
        },
        "modules": [
          "context",
          "resource"
        ]
      },
      {
        "id": "publish",
        "title": "MQTT 消息发布",
        "description": "按 QoS / Retain 发布消息，JSON 即时校验（非法仍按原文发送），附发送历史回填。",
        "entry": "ui/pages/publish/dist/bundle.js",
        "surface": "tab",
        "singleton": false,
        "backends": {
          "resource": "main"
        },
        "modules": [
          "context",
          "resource"
        ]
      },
      {
        "id": "topics",
        "title": "MQTT 主题树",
        "description": "按层级聚合观测到的主题（含 retained 标记），可订阅分支、查看分支最新消息并清除 retained。",
        "entry": "ui/pages/topics/dist/bundle.js",
        "surface": "tab",
        "singleton": false,
        "backends": {
          "resource": "main"
        },
        "modules": [
          "context",
          "resource"
        ]
      }
    ]
  }
}
