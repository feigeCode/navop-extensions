{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://navop.dev/schemas/extension-manifest.schema.json",
  "title": "Navop Extension Manifest",
  "description": "Navop extension.json manifest (schema_version 1)",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "name",
    "version",
    "engines"
  ],
  "additionalProperties": true,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+"
    },
    "publisher": {
      "type": "string"
    },
    "license": {
      "type": "string"
    },
    "homepage": {
      "type": "string"
    },
    "repository": {
      "type": "string"
    },
    "icon": {
      "type": "string"
    },
    "description_i18n": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "engines": {
      "type": "object",
      "required": [
        "onetcli"
      ],
      "additionalProperties": false,
      "properties": {
        "onetcli": {
          "type": "string"
        },
        "gpui_shell": {
          "type": "string"
        },
        "nsh": {
          "type": "string"
        }
      }
    },
    "api": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "properties": {
        "extension": {
          "type": "string"
        },
        "database": {
          "type": "string"
        },
        "ui": {
          "type": "string"
        },
        "task": {
          "type": "string"
        },
        "connection": {
          "type": "string"
        },
        "shell": {
          "type": "string"
        }
      }
    },
    "activation": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(spawn:|net:(tcp|udp):|net:unix:|secrets:(read|write):|shell:exec|fs:|process:|clipboard:|storage:)"
      }
    },
    "runtime": {
      "$ref": "#/definitions/runtimeSection"
    },
    "contributes": {
      "$ref": "#/definitions/contributes"
    }
  },
  "definitions": {
    "runtimeSection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ipc": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ipcRuntime"
          }
        },
        "wasm": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/wasmRuntime"
          }
        }
      }
    },
    "ipcRuntime": {
      "type": "object",
      "required": [
        "id",
        "entry"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "entry": {
          "type": "object",
          "required": [
            "command"
          ],
          "additionalProperties": false,
          "properties": {
            "command": {
              "type": "string"
            },
            "args": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "working_dir": {
              "type": "string"
            },
            "env": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        },
        "transport": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "type": "string"
            },
            "connect_timeout_ms": {
              "type": "number"
            }
          }
        },
        "auto_restart": {
          "type": "boolean"
        },
        "max_restart_attempts": {
          "type": "number"
        },
        "shutdown_grace_ms": {
          "type": "number"
        }
      }
    },
    "wasmRuntime": {
      "type": "object",
      "required": [
        "id",
        "module",
        "kind"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "module": {
          "type": "string"
        },
        "kind": {
          "const": "component"
        },
        "timeout_ms": {
          "type": "number"
        },
        "max_memory_mb": {
          "type": "number"
        },
        "fuel_per_call": {
          "type": "number"
        }
      }
    },
    "contributes": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "languages": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "path": {
                "type": "string"
              },
              "file_extensions": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "connectionImporters": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/connectionImporter"
          }
        },
        "connections": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/resourceConnection"
          }
        },
        "shellApp": {
          "$ref": "#/definitions/shellApp"
        },
        "panels": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/panel"
          }
        },
        "commands": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "handler"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "category": {
                "type": "string"
              },
              "icon": {
                "type": "string",
                "description": "相对扩展根目录的图标（SVG/PNG）：命令声明后，DB 树右键菜单项会显示它"
              },
              "enablement_when": {
                "type": "string"
              },
              "handler": {
                "type": "object",
                "required": [],
                "properties": {
                  "kind": {
                    "type": "string",
                    "description": "builtin（默认，暂不支持）、wasm（headless 动作）或 nsh（打开本扩展的 shell app tab）"
                  },
                  "runtime_id": {
                    "type": "string"
                  },
                  "function": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "route": {
                    "type": "string",
                    "description": "仅 kind == nsh：打开 app 时的初始路由，进 host.params.route"
                  }
                }
              }
            }
          }
        },
        "menus": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/menuContrib"
            }
          }
        },
        "toolbars": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/toolbarContrib"
            }
          }
        },
        "keybindings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "command",
              "key"
            ],
            "properties": {
              "command": {
                "type": "string"
              },
              "key": {
                "type": "string"
              },
              "mac": {
                "type": "string"
              },
              "linux": {
                "type": "string"
              },
              "windows": {
                "type": "string"
              },
              "when": {
                "type": "string"
              }
            }
          }
        },
        "htmlPreviewTransforms": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "runtimeId": {
                "type": "string"
              },
              "function": {
                "type": "string"
              },
              "languages": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "assets": {
                "type": "string"
              }
            }
          }
        },
        "documentRenderers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "displayName"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "displayName": {
                "type": "string"
              },
              "runtimeId": {
                "type": "string"
              },
              "function": {
                "type": "string"
              },
              "blockKinds": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "outputMediaTypes": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "priority": {
                "type": "number"
              }
            }
          }
        },
        "documentExporters": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "displayName"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "displayName": {
                "type": "string"
              },
              "runtimeId": {
                "type": "string"
              },
              "function": {
                "type": "string"
              },
              "formats": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "outputMediaTypes": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "priority": {
                "type": "number"
              }
            }
          }
        },
        "remoteFileEditors": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/remoteFileEditor"
          }
        }
      }
    },
    "shellApp": {
      "type": "object",
      "required": [
        "entry"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "icon": {
          "type": "string",
          "description": "相对扩展根目录的图标（SVG/PNG）：标签页 + 工具箱卡片；面板图标缺省时也回落它"
        },
        "entry": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string"
        },
        "keywords": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "backends": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "modules": {
          "type": "array",
          "items": {
            "enum": [
              "resource",
              "job",
              "event",
              "blob",
              "log",
              "runtime",
              "dev",
              "app",
              "db",
              "ui",
              "terminal",
              "ai"
            ]
          },
          "description": "页面可用的宿主模块。resource/job/event/blob/runtime/log/dev 走 host.call 字符串通道；app/ui/terminal/db 走 nsh 的 nativeModule（nativeModule(\"navop\").App 等）；ai 授予 navop.ai.*（页面用 host.post 上报 AI 上下文、host.call 唤起侧栏）。未声明的模块在调用时报 PERMISSION_DENIED。"
        }
      }
    },
    "panel": {
      "description": "扩展面板：终端侧边栏的第二 surface，要求 shellApp。",
      "type": "object",
      "required": [
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z0-9][a-z0-9._-]*[a-z0-9]$"
        },
        "title": {
          "type": "string",
          "maxLength": 40
        },
        "icon": {
          "type": "string",
          "minLength": 1,
          "description": "相对扩展根目录的图标（SVG/PNG），用作侧栏按钮；缺省回落 shellApp.icon，再没有用通用扩展图标"
        },
        "anchor": {
          "type": "string",
          "enum": [
            "terminal-sidebar",
            "db-sidebar"
          ],
          "default": "terminal-sidebar"
        },
        "order": {
          "type": "integer",
          "minimum": -1000,
          "maximum": 1000
        },
        "when": {
          "type": "string",
          "maxLength": 256
        }
      }
    },
    "resourceConnection": {
      "description": "资源连接。普通连接需要 runtimeId + resourceType（可带 route）；终端型连接用 terminal 直接起本地进程，不允许 runtimeId/resourceType/route。",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "id",
            "label",
            "runtimeId",
            "resourceType"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string"
            },
            "label": {
              "type": "string"
            },
            "description": {
              "type": "string"
            },
            "icon": {
              "type": "string"
            },
            "form": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "tabs": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "id",
                      "label"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "label": {
                        "type": "string"
                      },
                      "fields": {
                        "type": "array",
                        "items": {
                          "$ref": "#/definitions/formField"
                        }
                      }
                    }
                  }
                }
              }
            },
            "runtimeId": {
              "type": "string",
              "minLength": 1
            },
            "resourceType": {
              "type": "string",
              "minLength": 1
            },
            "route": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "required": [
            "id",
            "label",
            "terminal"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string"
            },
            "label": {
              "type": "string"
            },
            "description": {
              "type": "string"
            },
            "icon": {
              "type": "string"
            },
            "form": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "tabs": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "id",
                      "label"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "label": {
                        "type": "string"
                      },
                      "fields": {
                        "type": "array",
                        "items": {
                          "$ref": "#/definitions/formField"
                        }
                      }
                    }
                  }
                }
              }
            },
            "terminal": {
              "type": "object",
              "required": [
                "command"
              ],
              "additionalProperties": false,
              "properties": {
                "command": {
                  "type": "string",
                  "minLength": 1
                },
                "args": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "env": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                },
                "title": {
                  "type": "string"
                }
              }
            }
          }
        }
      ]
    },
    "formField": {
      "type": "object",
      "required": [
        "id",
        "label",
        "fieldType"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "not": {
            "enum": [
              "name",
              "workspace",
              "remark",
              "sync_enabled",
              "team_id"
            ]
          },
          "pattern": "^[^:/\\\\]+$"
        },
        "label": {
          "type": "string"
        },
        "fieldType": {
          "enum": [
            "Text",
            "Number",
            "Password",
            "TextArea",
            "Select",
            "Checkbox",
            "FilePath",
            "Auth",
            "Icon"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "defaultValue": {
          "type": "string"
        },
        "placeholder": {
          "type": "string"
        },
        "secret": {
          "type": "boolean"
        },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "value",
              "label"
            ],
            "additionalProperties": false,
            "properties": {
              "value": {
                "type": "string"
              },
              "label": {
                "type": "string"
              }
            }
          }
        },
        "visibleWhen": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "field",
              "equals"
            ],
            "additionalProperties": false,
            "properties": {
              "field": {
                "type": "string"
              },
              "equals": {
                "type": "string"
              }
            }
          }
        },
        "rows": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "connectionImporter": {
      "type": "object",
      "required": [
        "id",
        "displayName"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "runtimeId": {
          "type": "string"
        },
        "displayName": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "icon": {
          "type": "string"
        },
        "outputKinds": {
          "type": "array",
          "items": {
            "enum": [
              "database",
              "ssh",
              "telnet",
              "port-forwarding",
              "quick-command",
              "workspace"
            ]
          }
        },
        "platforms": {
          "type": "array",
          "items": {
            "enum": [
              "macos",
              "windows",
              "linux"
            ]
          }
        },
        "manualFilePick": {
          "type": "object",
          "properties": {
            "prompt": {
              "type": "string"
            },
            "supportsDirectories": {
              "type": "boolean"
            },
            "directoryPrompt": {
              "type": "string"
            }
          }
        },
        "candidateFiles": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "path"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "platform": {
                "type": "string"
              },
              "path": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "remoteFileEditor": {
      "type": "object",
      "required": [
        "id",
        "displayName",
        "command"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "displayName": {
          "type": "string"
        },
        "platforms": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "fileMasks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "priority": {
          "type": "number"
        },
        "command": {
          "type": "object",
          "properties": {
            "launchMode": {
              "enum": [
                "direct",
                "macos_open"
              ]
            },
            "programCandidates": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "args": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "menuContrib": {
      "type": "object",
      "required": [
        "command"
      ],
      "properties": {
        "command": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "group": {
          "type": "string"
        },
        "when": {
          "type": "string"
        },
        "requires_active": {
          "type": "boolean"
        }
      }
    },
    "toolbarContrib": {
      "type": "object",
      "required": [
        "command"
      ],
      "properties": {
        "command": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "group": {
          "type": "string"
        },
        "when": {
          "type": "string"
        },
        "text_when": {
          "type": "string"
        },
        "icon_only": {
          "type": "boolean"
        },
        "priority": {
          "type": "number"
        }
      }
    }
  }
}
